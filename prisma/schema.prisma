// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model funcionario {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  telefone String
  password String
}

model cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  comentario String
  foto   String
}
model pontoTuristico {
  id       Int    @id @default(autoincrement())
  nome    String
  categoria  String
  descricao  String
  endereco String
  foto   String
}

model eventos {
  id       Int    @id @default(autoincrement())
  nome     String
  local   String
  contato String
  descricao  String
  foto   String
}

model gastronomia {
  id       Int    @id @default(autoincrement())
  nome     String
  categoria  String
  telefone String
  descricao String
  foto   String
}
model hospedagem {
  id       Int    @id @default(autoincrement())
  nome     String
  telefone String
  descricao String
  foto   String
}

model foto {
  id       Int      @id @default(autoincrement())
  titulo   String
  url      String
  criadoEm DateTime @default(now())
}